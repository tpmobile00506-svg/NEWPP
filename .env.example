# PostgreSQL Connection (local or cloud Neon/Supabase/RDS)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Session Security
SESSION_SECRET="replace-with-a-random-secret-at-least-32-chars"
FRONTEND_ORIGIN="http://localhost:3000"
SESSION_COOKIE_SECURE=false

# Initial Admin bootstrap credentials (used by npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"
ADMIN_NAME="ผู้ดูแลระบบ"
